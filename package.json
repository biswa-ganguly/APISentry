{
  "name": "apisentry-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "APISentry - Local-first API Contract Guard static analysis engine and VS Code extension",
  "scripts": {
    "build": "pnpm --recursive run build",
    "preview": "node apps/cli/dist/index.js preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit --skipLibCheck",
    "typecheck": "pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
